# Placeholder values only. Copy to .env and edit; never commit the real .env.
# Relative paths are resolved against the project root (not the MCP host's working directory).

# OAuth 2.0 Desktop app client JSON downloaded from Google Cloud Console.
GOOGLE_OAUTH_CREDENTIALS_PATH=/ABSOLUTE/PATH/TO/credentials.json

# Where `npm run auth` stores the refresh token (created with 0600 permissions).
# Default: ~/.config/google-workspace-mcp/token.json
GOOGLE_OAUTH_TOKEN_PATH=/ABSOLUTE/USER-PRIVATE/PATH/google-workspace-mcp-token.json

# --- Railway / HTTP transport (optional; local stdio does not need these) ---
# Bearer token for POST /mcp. Required when running `npm run start:http` or the Docker image.
# Generate with: openssl rand -base64 48
# MCP_AUTH_TOKEN=

# Inline OAuth client JSON (raw JSON or base64). Used instead of GOOGLE_OAUTH_CREDENTIALS_PATH when set.
# GOOGLE_OAUTH_CREDENTIALS_JSON=

# Seed for the refresh-token file on first boot only (raw JSON or base64).
# After the file exists (e.g. on a Railway volume at /data/token.json), remove this variable.
# GOOGLE_OAUTH_TOKEN_JSON=
