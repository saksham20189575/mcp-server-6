{
  "name": "google-workspace-mcp",
  "version": "0.1.0",
  "description": "Minimal local MCP server exposing send_email (Gmail) and append_to_google_doc (Google Docs).",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "google-workspace-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "auth": "tsx scripts/authorize.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^178.0.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
